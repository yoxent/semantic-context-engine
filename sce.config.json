{
  "embedding": {
    "provider": "openai-compatible",
    "baseUrl": "https://openrouter.ai/api/v1",
    "model": "nvidia/nemotron-3-embed-1b:free",
    "dimensions": 2048,
    "batchSize": 10,
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "indexing": {
    "include": ["**/*.md"],
    "ignore": [
      "**/knowledge/**",
      "**/.pi-subagents/**",
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/RESUME-*.md"
    ]
  }
}
